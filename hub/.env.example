HUB_BOT_TOKEN=your-hub-telegram-bot-token-here

# Optional overrides if usernames change
MEDICINE_BOT_USERNAME=CharanasMedicine_bot
DENTISTRY_BOT_USERNAME=Charanasdentistry_bot
PHARMACY_BOT_USERNAME=Charanaspharmacy_bot
MLS_BOT_USERNAME=CharanasMLS_bot
NURSING_BOT_USERNAME=Charanasnursing_bot

# Channel join gate (Telegram cannot auto-add users; hub requires join then verifies)
# Public channel: set CHANNEL_USERNAME without @
# Private channel: set CHANNEL_CHAT_ID=-100... and CHANNEL_INVITE_LINK=https://t.me/+...
# Hub bot must be an *admin* of the channel so membership checks work.
CHANNEL_USERNAME=
CHANNEL_INVITE_LINK=https://t.me/+yourPrivateInvite
CHANNEL_CHAT_ID=
REQUIRE_CHANNEL=1

# Optional: Telegram shared folder link (Settings → Chat Folders → Share).
# Can include your channel/groups. Telegram does NOT allow bots in shared folders.
# Example: https://t.me/addlist/XXXXXXXXXXXX
FOLDER_INVITE_LINK=
FOLDER_NAME=CharaNas
