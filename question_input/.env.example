# Create a new bot with @BotFather, then paste the token here.
QUESTION_INPUT_BOT_TOKEN=your-question-input-bot-token-here

# Optional: comma-separated Telegram user IDs allowed to submit content.
# Leave empty to allow anyone who can open the bot.
INPUT_ADMIN_IDS=

# Optional public username (for docs / hub links)
QUESTION_INPUT_BOT_USERNAME=

# Perplexity API — used by "Generate Short MCQs (Perplexity)" in this bot.
# Get a key from https://www.perplexity.ai/account/api/keys
PERPLEXITY_API_KEY=
# Optional overrides:
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
#
# Flow: form (department/stage/curriculum/count/topic/difficulty mix)
# → Perplexity returns strict JSON → validate → save directly into the bank
